  "info": {
    "title": "BADDIES API",
    "version": "1.0.0",
    "description": "API du frontend BADDIES. Utiliser uniquement des comptes et données de test pour les essais interactifs. Le moniteur /health ne vérifie pas la base."
  },
  "servers": [
    {
      "url": "/",
      "description": "Serveur courant"
    }
