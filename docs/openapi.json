  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Message": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "invalidParams": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "pseudo": {
            "type": "string"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Register": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "description": "Inscription/connexion : majuscule, chiffre et symbole requis. Réinitialisation/profil : minuscule également requise."
          },
          "pseudo": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          }
        },
        "required": [
          "email",
          "password",
          "pseudo"
        ],
        "additionalProperties": false
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "description": "Inscription/connexion : majuscule, chiffre et symbole requis. Réinitialisation/profil : minuscule également requise."
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "Token": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Refresh token brut de 64 caractères hexadécimaux."
          }
        },
        "required": [
          "token"
        ]
      },
      "ForgotPassword": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPassword": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "newPassword": {
            "type": "string",
            "minLength": 6,
            "description": "Inscription/connexion : majuscule, chiffre et symbole requis. Réinitialisation/profil : minuscule également requise."
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "ProfileUpdate": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "pseudo": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "description": "Inscription/connexion : majuscule, chiffre et symbole requis. Réinitialisation/profil : minuscule également requise."
          },
          "avatar_url": {
            "type": "string",
            "description": "Chemin local commençant par / ; URL distante refusée."
          }
        }
      },
      "HistoryInput": {
        "type": "object",
        "properties": {
          "evaluation": {
            "description": "Données de l’évaluation ; structure métier fournie par le front."
          },
          "solutions": {
            "description": "Solutions associées ; structure métier fournie par le front."
          }
        },
        "required": [
          "evaluation",
          "solutions"
        ]
      },
      "History": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "evaluation": {},
